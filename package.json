{
  "name": "pi-acp-workbench",
  "displayName": "Pi ACP Workbench",
  "description": "Pi agent over ACP, with streaming Markdown, LaTeX math and editor context.",
  "version": "0.11.1",
  "publisher": "local-pi",
  "license": "MIT",
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "main": "./dist/extension.cjs",
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onView:piAcp.chat"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Pi can execute commands and edit files in the workspace."
    },
    "virtualWorkspaces": false
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "piAcp",
          "title": "Pi Agent",
          "icon": "media/pi.svg"
        }
      ]
    },
    "views": {
      "piAcp": [
        {
          "id": "piAcp.chat",
          "name": "Pi Agent",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "piAcp.open",
        "title": "Pi: Open Chat"
      },
      {
        "command": "piAcp.newSession",
        "title": "Pi: New Session",
        "icon": "$(add)"
      },
      {
        "command": "piAcp.attachSelection",
        "title": "Pi: Add Selection to Chat"
      },
      {
        "command": "piAcp.login",
        "title": "Pi Workbench: Open Current Harness Login Terminal"
      },
      {
        "command": "piAcp.preview",
        "title": "Pi: Preview Markdown & Math"
      },
      {
        "command": "piAcp.logs",
        "title": "Pi: Show Agent Logs"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "piAcp.newSession",
          "when": "view == piAcp.chat",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "piAcp.attachSelection",
          "when": "editorHasSelection",
          "group": "pi"
        }
      ]
    },
    "keybindings": [
      {
        "command": "piAcp.attachSelection",
        "key": "ctrl+alt+p",
        "mac": "cmd+alt+p",
        "when": "editorTextFocus && editorHasSelection"
      }
    ],
    "configuration": {
      "title": "Pi ACP",
      "properties": {
        "piAcp.codex.loginCommand": {
          "type": "string",
          "default": "codex",
          "scope": "machine",
          "description": "Interactive Codex CLI used by Open Login Terminal (runs codex login). This is separate from codex-acp."
        },
        "piAcp.showThoughts": {
          "type": "boolean",
          "default": true,
          "description": "Show thought chunks when the agent emits them."
        },
        "piAcp.persistHistory": {
          "type": "boolean",
          "default": true,
          "description": "Show history in this client. The session service persists tasks for every harness; Delete History removes server records."
        },
        "piAcp.maxContextChars": {
          "type": "number",
          "default": 60000,
          "minimum": 1000,
          "maximum": 500000,
          "description": "Maximum characters in an attached editor selection or file."
        },
        "piAcp.serviceSocket": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Pi session service Unix socket. Empty uses ~/.pi/pi-acp-workbench/service/sessions.sock. Pi processes and model environment are configured in sessions.json; reload the window after changing this path."
        },
        "piAcp.claude.loginCommand": {
          "type": "string",
          "default": "claude-agent-acp",
          "scope": "machine",
          "description": "Executable used by the login terminal (--cli /login). Worker commands belong in sessions.json."
        }
      }
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:services": "npm run build && node scripts/build-services.mjs",
    "build:service:test": "cargo build --manifest-path rust/Cargo.toml --workspace",
    "check": "tsc --noEmit",
    "format": "prettier --write . && cargo fmt --manifest-path rust/Cargo.toml --all",
    "format:check": "prettier --check . && cargo fmt --manifest-path rust/Cargo.toml --all -- --check",
    "test": "npm run check && npm run build:service:test && vitest run --changed --passWithNoTests",
    "test:all": "npm run check && npm run build:service:test && vitest run",
    "test:full": "node scripts/test-full.mjs",
    "test:runner": "node --test scripts/test-pool.test.mjs scripts/test-reports.test.mjs scripts/telegram-setup.test.mjs",
    "verify": "npm run clippy && npm run test:full && npm run test:browser",
    "package": "vsce package --no-dependencies --allow-missing-repository --out ../pi-acp-workbench-$npm_package_version.vsix",
    "vscode:prepublish": "npm run check && npm run build",
    "test:browser": "npm run build && node scripts/browser-smoke.mjs",
    "test:harness": "node scripts/harness-reconnect-smoke.mjs",
    "test:native-fork": "npm run build && node scripts/native-fork-smoke.mjs",
    "test:pi-fast": "node scripts/pi-fast-smoke.mjs",
    "test:contract": "npm run build:service:test && node scripts/service-contract.mjs",
    "test:contract:telegram": "cargo build --manifest-path rust/Cargo.toml --features pi-acp-telegram-daemon/contract-test --target-dir rust/target/contract && node scripts/telegram-contract.mjs",
    "test:integration:rust": "npm run build:service:test && cargo build --manifest-path rust/Cargo.toml --features pi-acp-telegram-daemon/contract-test --target-dir rust/target/contract && node scripts/rust-integration.mjs",
    "telegram": "node scripts/run-service.mjs telegram",
    "sessions": "node scripts/run-service.mjs sessions",
    "test:memory": "npm run build:service:test && node scripts/memory-smoke.mjs",
    "generate:protocol": "npm run build:service:test && node scripts/generate-service-types.mjs",
    "check:protocol": "node scripts/generate-service-types.mjs --check",
    "test:service:rollback": "node scripts/service-rollback.mjs",
    "test:service:soak": "node scripts/service-soak.mjs",
    "test:service:artifact": "node scripts/service-artifact-smoke.mjs",
    "package:services": "node scripts/package-services.mjs",
    "clippy": "cargo clippy --manifest-path rust/Cargo.toml --workspace --all-targets -- -D warnings",
    "fixtures": "node scripts/export-fixtures.mjs",
    "telegram:setup": "node scripts/setup-telegram.mjs"
  },
  "overrides": {
    "katex": "$katex"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.7.0",
    "dompurify": "3.4.16",
    "highlight.js": "11.11.1",
    "katex": "0.19.0",
    "markdown-it": "15.0.2",
    "markdown-it-footnote": "4.0.0",
    "markdown-it-task-lists": "2.1.1",
    "mermaid": "11.17.2",
    "pi-acp": "0.0.34",
    "proper-lockfile": "4.1.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/jsdom": "^21.1.0",
    "@types/markdown-it-footnote": "^3.0.4",
    "@types/node": "^22.0.0",
    "@types/proper-lockfile": "^4.1.4",
    "@types/vscode": "1.96.0",
    "@vscode/vsce": "^3.6.0",
    "esbuild": "^0.25.0",
    "jsdom": "^26.1.0",
    "prettier": "3.6.2",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ustc-mkh/pi-acp-workbench.git"
  },
  "bugs": {
    "url": "https://github.com/ustc-mkh/pi-acp-workbench/issues"
  }
}
