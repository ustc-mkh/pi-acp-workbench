{
  "name": "pi-acp-workbench",
  "displayName": "Pi ACP Workbench",
  "description": "Pi agent over ACP, with streaming Markdown, LaTeX math and editor context.",
  "version": "0.3.1",
  "publisher": "local-pi",
  "license": "MIT",
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "main": "./dist/extension.cjs",
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onView:piAcp.chat"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Pi can execute commands and edit files in the workspace."
    },
    "virtualWorkspaces": false
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "piAcp",
          "title": "Pi Agent",
          "icon": "media/pi.svg"
        }
      ]
    },
    "views": {
      "piAcp": [
        {
          "id": "piAcp.chat",
          "name": "Pi Agent",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "piAcp.open",
        "title": "Pi: Open Chat"
      },
      {
        "command": "piAcp.newSession",
        "title": "Pi: New Session",
        "icon": "$(add)"
      },
      {
        "command": "piAcp.attachSelection",
        "title": "Pi: Add Selection to Chat"
      },
      {
        "command": "piAcp.login",
        "title": "Pi: Open Login Terminal"
      },
      {
        "command": "piAcp.preview",
        "title": "Pi: Preview Markdown & Math"
      },
      {
        "command": "piAcp.logs",
        "title": "Pi: Show Agent Logs"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "piAcp.newSession",
          "when": "view == piAcp.chat",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "piAcp.attachSelection",
          "when": "editorHasSelection",
          "group": "pi"
        }
      ]
    },
    "keybindings": [
      {
        "command": "piAcp.attachSelection",
        "key": "ctrl+alt+p",
        "mac": "cmd+alt+p",
        "when": "editorTextFocus && editorHasSelection"
      }
    ],
    "configuration": {
      "title": "Pi ACP",
      "properties": {
        "piAcp.command": {
          "type": "string",
          "default": "pi-acp",
          "scope": "machine",
          "description": "ACP executable override. The default pi-acp with empty args uses the bundled enhanced adapter unless useBundledAdapter is false."
        },
        "piAcp.args": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "machine",
          "description": "Arguments passed directly without a shell."
        },
        "piAcp.env": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "scope": "machine",
          "description": "Agent environment overrides. Prefer provider credentials stored by Pi; avoid saving secrets here."
        },
        "piAcp.showThoughts": {
          "type": "boolean",
          "default": true,
          "description": "Show thought chunks when the agent emits them."
        },
        "piAcp.sharedHistory": {
          "type": "boolean",
          "default": true,
          "scope": "machine",
          "description": "Share conversation history between clients of the same server account under ~/.pi/pi-acp-workbench/history. Changes require reloading the window."
        },
        "piAcp.persistHistory": {
          "type": "boolean",
          "default": true,
          "description": "Save conversation history. In shared mode, disabling only hides/stops saving history on this client; use Clear History to delete server-wide records. In local mode, disabling clears local snapshots. Usage totals remain."
        },
        "piAcp.maxContextChars": {
          "type": "number",
          "default": 60000,
          "minimum": 1000,
          "maximum": 500000,
          "description": "Maximum characters in an attached editor selection or file."
        },
        "piAcp.useBundledAdapter": {
          "type": "boolean",
          "default": true,
          "scope": "machine",
          "description": "Use the bundled enhanced Pi ACP adapter when command is pi-acp and args is empty. Enables bounded context summaries and detailed usage statistics."
        }
      }
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "package": "npm run build && vsce package --no-dependencies --allow-missing-repository --out ../pi-acp-workbench-0.3.1.vsix",
    "vscode:prepublish": "npm run check && npm run build",
    "test:browser": "npm run build && node scripts/browser-smoke.mjs"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.7.0",
    "dompurify": "3.4.16",
    "highlight.js": "11.11.1",
    "katex": "0.19.0",
    "markdown-it": "15.0.2",
    "markdown-it-footnote": "4.0.0",
    "markdown-it-task-lists": "2.1.1",
    "mermaid": "11.17.2",
    "pi-acp": "0.0.34",
    "proper-lockfile": "4.1.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/jsdom": "^21.1.0",
    "@types/katex": "^0.16.7",
    "@types/markdown-it": "^14.1.0",
    "@types/markdown-it-footnote": "^3.0.4",
    "@types/node": "^22.0.0",
    "@types/proper-lockfile": "^4.1.4",
    "@types/vscode": "1.96.0",
    "@vscode/vsce": "^3.6.0",
    "esbuild": "^0.25.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ustc-mkh/pi-acp-workbench.git"
  },
  "bugs": {
    "url": "https://github.com/ustc-mkh/pi-acp-workbench/issues"
  }
}
