{
  "name": "pi-acp-workbench",
  "displayName": "Pi ACP Workbench",
  "description": "Pi agent over ACP, with streaming Markdown, LaTeX math and editor context.",
  "version": "2.0.7",
  "publisher": "local-pi",
  "license": "MIT",
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "main": "./dist/extension.cjs",
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onView:piAcp.chat"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Pi can execute commands and edit files in the workspace."
    },
    "virtualWorkspaces": false
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "piAcp",
          "title": "Pi Agent",
          "icon": "media/pi.svg"
        }
      ]
    },
    "views": {
      "piAcp": [
        {
          "id": "piAcp.chat",
          "name": "Pi Agent",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "piAcp.open",
        "title": "Pi: Open Chat"
      },
      {
        "command": "piAcp.newSession",
        "title": "Pi: New Session",
        "icon": "$(add)"
      },
      {
        "command": "piAcp.attachSelection",
        "title": "Pi: Add Selection to Chat"
      },
      {
        "command": "piAcp.login",
        "title": "Pi Workbench: Provider Login"
      },
      {
        "command": "piAcp.logs",
        "title": "Pi: Show Agent Logs"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "piAcp.newSession",
          "when": "view == piAcp.chat",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "piAcp.attachSelection",
          "when": "editorHasSelection",
          "group": "pi"
        }
      ]
    },
    "keybindings": [
      {
        "command": "piAcp.attachSelection",
        "key": "ctrl+alt+p",
        "mac": "cmd+alt+p",
        "when": "editorTextFocus && editorHasSelection"
      }
    ],
    "configuration": {
      "title": "Pi ACP",
      "properties": {
        "piAcp.workbenchSocket": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "IPC v3 socket of pi-acp-workbenchd. Empty uses ~/.pi/pi-acp-workbench/workbench.sock. Configure workers/storage in workbench.json; reload after changing this path. No legacy socket fallback."
        }
      }
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:workbenchd": "cargo build --manifest-path rust/Cargo.toml -p pi-acp-workbenchd",
    "run:workbenchd": "cargo run --manifest-path rust/Cargo.toml -p pi-acp-workbenchd --",
    "build:services": "node scripts/build-services.mjs",
    "check": "tsc --noEmit",
    "audit:workbench": "node scripts/audit-workbench.mjs",
    "format": "prettier --write . && cargo fmt --manifest-path rust/Cargo.toml --all",
    "format:check": "prettier --check . && cargo fmt --manifest-path rust/Cargo.toml --all -- --check",
    "test": "npm run check && npm run build:workbenchd && vitest run",
    "test:rewrite": "node scripts/test-rewrite.mjs",
    "test:changed": "npm run check && npm run build:workbenchd && vitest run --changed --passWithNoTests",
    "test:full": "node scripts/test-full.mjs",
    "test:runner": "node --test scripts/test-pool.test.mjs scripts/test-reports.test.mjs scripts/ci-failure-diagnostics.test.mjs scripts/typescript-graph.test.mjs scripts/workbench-binary.test.mjs scripts/prepare-release.test.mjs scripts/workbench-sqlite-fixture.test.mjs scripts/release-contract.test.mjs",
    "verify": "npm run clippy && npm run test:full && npm run test:browser",
    "package": "vsce package --no-dependencies --allow-missing-repository --out pi-acp-workbench-$npm_package_version.vsix",
    "vscode:prepublish": "npm run check && npm run build",
    "test:extension-host": "npm run build && npm run build:workbenchd && node scripts/workbench-extension-host.mjs",
    "test:extension-host:full": "npm run build && npm run build:workbenchd && node scripts/workbench-extension-host.mjs --full",
    "test:browser": "npm run build && cargo build --manifest-path rust/Cargo.toml -p pi-acp-workbenchd && node scripts/workbench-browser-smoke.mjs",
    "test:harness": "node scripts/harness-reconnect-smoke.mjs",
    "test:native-fork": "npm run build && node scripts/native-fork-smoke.mjs",
    "test:native-fork:offline": "npm run build && node scripts/native-fork-offline.mjs",
    "test:pi-fast": "node scripts/pi-fast-smoke.mjs",
    "test:contract:workbench": "cargo build --manifest-path rust/Cargo.toml -p pi-acp-workbenchd && node scripts/workbench-contract.mjs",
    "test:contract:workbench:telegram": "cargo build --manifest-path rust/Cargo.toml -p pi-acp-workbenchd && node scripts/workbench-telegram-contract.mjs",
    "workbench:storage": "node scripts/workbench-storage.mjs",
    "test:workbench:storage": "npm run build:workbenchd && vitest run test/workbench-storage.test.ts",
    "test:workbench:process-loss": "npm run build:workbenchd && node scripts/workbench-process-loss.mjs",
    "test:workbench:image-race": "npm run build:workbenchd && node scripts/workbench-image-race.mjs",
    "test:workbench:capacity": "npm run build:workbenchd && node scripts/workbench-idle-worker-repro.mjs",
    "test:workbench:startup": "npm run build:workbenchd && node scripts/workbench-startup.mjs",
    "test:workbench:scale": "node scripts/workbench-scale.mjs",
    "test:workbench:mixed": "node scripts/workbench-mixed.mjs",
    "test:workbench:diff-benchmark": "node scripts/workbench-mixed.mjs --workload diff --release",
    "test:workbench:provider-barriers": "npm run build:workbenchd && node scripts/workbench-provider-barriers.mjs",
    "test:workbench:host-mixed": "node scripts/workbench-host-mixed.mjs",
    "test:workbench:soak": "npm run build:workbenchd && node scripts/workbench-soak.mjs",
    "test:service:artifact": "node scripts/service-artifact-smoke.mjs",
    "package:services": "node scripts/package-services.mjs",
    "clippy": "cargo clippy --manifest-path rust/Cargo.toml --workspace --all-targets -- -D warnings"
  },
  "overrides": {
    "katex": "$katex",
    "zod": "4.6.7"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.8.0",
    "dompurify": "3.4.17",
    "highlight.js": "11.12.0",
    "katex": "0.19.0",
    "markdown-it": "15.0.3",
    "markdown-it-footnote": "4.0.0",
    "markdown-it-task-lists": "2.1.1",
    "mermaid": "12.1.0",
    "pi-acp": "0.0.34",
    "proper-lockfile": "4.1.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/jsdom": "^21.1.0",
    "@types/markdown-it-footnote": "^3.0.4",
    "@types/node": "^22.0.0",
    "@types/proper-lockfile": "^4.1.4",
    "@types/vscode": "1.96.0",
    "@vscode/vsce": "4.0.0",
    "esbuild": "0.28.2",
    "jsdom": "^26.1.0",
    "prettier": "3.6.2",
    "typescript": "^5.9.0",
    "vitest": "4.1.11"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ustc-mkh/pi-acp-workbench.git"
  },
  "bugs": {
    "url": "https://github.com/ustc-mkh/pi-acp-workbench/issues"
  }
}
