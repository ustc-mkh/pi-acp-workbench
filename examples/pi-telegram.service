[Unit]
Description=Pi ACP Workbench Telegram relay
After=network-online.target pi-sessions.service
Wants=network-online.target pi-sessions.service

[Service]
Type=simple
WorkingDirectory=/absolute/path/to/pi-acp-workbench
EnvironmentFile=%h/.config/pi-acp-workbench/telegram.env
ExecStart=/absolute/path/to/pi-acp-workbench/service-dist/pi-acp-telegram-daemon --config %h/.config/pi-acp-workbench/telegram.json
Restart=on-failure
RestartSec=10
TimeoutStopSec=45
KillMode=control-group
UMask=0077
# The relay never spawns processes; these filters need no root or user namespaces.
NoNewPrivileges=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
# Optional, if unprivileged user namespaces are available on this host:
# PrivateTmp=yes
# ProtectSystem=strict
# ProtectHome=read-only
# ReadWritePaths=%h/.pi/pi-acp-workbench

[Install]
WantedBy=default.target
