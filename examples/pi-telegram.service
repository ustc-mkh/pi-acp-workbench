[Unit]
Description=Pi ACP Workbench Telegram relay
After=network-online.target pi-sessions.service
Wants=network-online.target pi-sessions.service

[Service]
Type=simple
WorkingDirectory=/absolute/path/to/pi-acp-workbench
EnvironmentFile=%h/.config/pi-acp-workbench/telegram.env
ExecStart=/absolute/path/to/pi-acp-workbench/service-dist/pi-acp-telegram-daemon --config %h/.config/pi-acp-workbench/telegram.json
Restart=on-failure
RestartSec=10
TimeoutStopSec=45
KillMode=control-group
UMask=0077

[Install]
WantedBy=default.target
